<Window x:Class="ChestCounter.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Cofres"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" Foreground="#FFF2F2F2">
    <Border CornerRadius="10" Background="#F0101319" BorderBrush="#66F5C542" BorderThickness="1"
            Padding="14,10,14,10" MinWidth="240">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="COFRES ABIERTOS" FontSize="11" FontWeight="SemiBold" Foreground="#FFB9BEC9" />
                <TextBlock Grid.Column="1" Text="{Binding LiveText}" FontSize="11" FontWeight="SemiBold" Foreground="#FF6EE787" />
            </Grid>

            <TextBlock Text="{Binding TotalText}" FontSize="40" FontWeight="Bold" Foreground="#FFF5C542" Margin="0,-4,0,0" />
            <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="#FFE4E6EB" />

            <Border Height="1" Background="#33FFFFFF" Margin="0,8,0,6" />

            <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding When}" FontSize="12" Foreground="#FFB9BEC9" />
                            <TextBlock Grid.Column="1" Text="{Binding Note}" FontSize="11" Foreground="#FF8A909C"
                                       Margin="8,1,8,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Counted}" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#FF8A909C" Margin="0,6,0,0"
                       TextWrapping="Wrap" MaxWidth="280" />
        </StackPanel>
    </Border>
</Window>
